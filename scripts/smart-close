#!/usr/bin/env python3
"""Safe Super+Q wrapper for Hyprland.

Ghostty does not use Kitty's kitten-based OS-window close confirmation, so the
old Kitty-specific second-press machinery is intentionally gone. Moonlight
remains protected because closing the stream window accidentally is disruptive;
every other window receives the normal Hyprland close request.
"""
from __future__ import annotations

import json
import subprocess
import sys

MOONLIGHT_CLASS = "com.moonlight_stream.Moonlight"


def run(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, text=True, capture_output=True)


def active_window() -> dict:
    proc = run("hyprctl", "activewindow", "-j")
    if proc.returncode != 0 or not proc.stdout.strip():
        return {}
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {}


def normal_close() -> int:
    return run("hyprctl", "eval", "hl.dispatch(hl.dsp.window.close())").returncode


def main() -> int:
    window = active_window()
    if not window:
        return 0

    window_class = str(window.get("class") or window.get("initialClass") or "")
    try:
        pid = int(window.get("pid") or 0)
    except (TypeError, ValueError):
        pid = 0

    protected = window_class == MOONLIGHT_CLASS
    if "--probe" in sys.argv:
        print(json.dumps({"class": window_class, "pid": pid, "protected": protected}))
        return 0

    if protected:
        return 0
    return normal_close()


if __name__ == "__main__":
    raise SystemExit(main())
